          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT eod_timestamp as \"DATA EOD\" , step_id as \"STEP EOD\" , description as \"DESCIZIONE STEP\", messages as \"MESSAGGIO\" ,    CASE \r\n        WHEN step_id <> 18 THEN 1 \r\n        ELSE 0 \r\n    END AS ALERT_FLAG\r\nFROM (\r\n    SELECT \r\n        eo.eod_timestamp, \r\n        eo.step_id, \r\n        op.description, \r\n        eo.messages,\r\n        ROW_NUMBER() OVER (PARTITION BY eo.eod_timestamp ORDER BY eo.step_id DESC) as rn\r\n    FROM tesi_eod.eod_process eo\r\n    JOIN tesi_eod.eod_operations op ON eo.step_id = op.id\r\n) as subquery\r\nWHERE rn = 1\r\nand eod_timestamp  BETWEEN $__timeFrom() AND $__timeTo()\r\nORDER BY eod_timestamp DESC;",
          "refId": "A",
          "sql": {
